# Copy to apps/web/.env.local. For the local stack, `npm run db:start` prints both values
# (API_URL and PUBLISHABLE_KEY). Leave them unset and sign-in shows as unavailable.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Email-in (#10). The server's secret key (`SECRET_KEY` from `npm run db:start`) lets the webhook
# file mail without a signed-in person. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# The domain boats' addresses are on: boats.heynewton.app on hosted projects. The sample boat's
# address is kittiwake@in.heynewton.test.
INBOUND_EMAIL_DOMAIN=in.heynewton.test
# From Resend: an API key that can read received mail, and the webhook's signing secret.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
