# Copy to apps/web/.env.local. For the local stack, `npm run db:start` prints both values
# (API_URL and PUBLISHABLE_KEY). Leave them unset and sign-in shows as unavailable.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# The server's secret key (`SECRET_KEY` from `npm run db:start`), for work with no signed-in
# person: the email-in webhook (#10), filing (#11) and the daily reminders (#12). Never expose it to
# the browser.
SUPABASE_SECRET_KEY=
# A Resend API key that can read received mail and send (one key serves both).
RESEND_API_KEY=

# Email-in (#10). The domain boats' addresses are on: boats.heynewton.app on prod,
# boats.dev.heynewton.app on the dev site (#109). Locally the sample boat's address is
# test-boat@in.heynewton.test. And the webhook's signing secret.
INBOUND_EMAIL_DOMAIN=in.heynewton.test
RESEND_WEBHOOK_SECRET=

# Filing (#11): Claude reads each stored document and proposes records. Without a key, documents
# stay unsorted and nothing is sent to Anthropic. FILING_MODEL overrides the model (optional).
ANTHROPIC_API_KEY=
FILING_MODEL=

# Reminders (#12) and the daily filing run (#11). Vercel Cron sends CRON_SECRET as a bearer token;
# the routes refuse calls without it. SITE_URL is the site the emails link to. REMINDERS_FROM is the
# sender, which must be on a domain the key's Resend team has verified: unset means
# Hey Newton <noreply@heynewton.app> (prod); the dev site sets
# Hey Newton <noreply@dev.heynewton.app> (#109).
CRON_SECRET=
SITE_URL=http://localhost:3000
REMINDERS_FROM=

# "Sign in as…" the sample boat's people on /sign-in, with no email (#97). Uses SUPABASE_SECRET_KEY.
# The Deploy workflow sets it on the dev site and previews; set it to 1 here to try it locally.
FIXTURE_SIGN_IN=
