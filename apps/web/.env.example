# Copy to apps/web/.env.local. For the local stack, `npm run db:start` prints both values
# (API_URL and PUBLISHABLE_KEY). Leave them unset and sign-in shows as unavailable.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# The server's secret key (`SECRET_KEY` from `npm run db:start`), for work with no signed-in
# person: the email-in webhook (#10) and the daily reminders (#12). Never expose it to the browser.
SUPABASE_SECRET_KEY=
# A Resend API key that can read received mail and send (one key serves both).
RESEND_API_KEY=

# Email-in (#10). The domain boats' addresses are on: boats.heynewton.app on hosted projects. The
# sample boat's address is kittiwake@in.heynewton.test. And the webhook's signing secret.
INBOUND_EMAIL_DOMAIN=in.heynewton.test
RESEND_WEBHOOK_SECRET=

# Reminders (#12). Vercel Cron sends CRON_SECRET as a bearer token; the route refuses calls without
# it. SITE_URL is the site the emails link to.
CRON_SECRET=
SITE_URL=http://localhost:3000
