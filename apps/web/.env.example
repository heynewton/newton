# Copy to apps/web/.env.local. For the local stack, `npm run db:start` prints both values
# (API_URL and PUBLISHABLE_KEY). Leave them unset and sign-in shows as unavailable.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Reminders (#12). The server's secret key (`SECRET_KEY` from `npm run db:start`) reads every
# boat for the daily digest. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Vercel Cron sends this as a bearer token; the route refuses calls without it.
CRON_SECRET=
# A Resend key with sending access, and the site the emails link to.
RESEND_API_KEY=
SITE_URL=http://localhost:3000
