# Copy to supabase/.env (git-ignored) to turn on Google sign-in on the local stack (#131), then
# restart it (npm run db:stop && npm run db:start). The Supabase CLI reads this file and these
# override supabase/config.toml. The values are the dev OAuth client's, from Google Cloud
# (docs/tokens.md, Google sign-in). Leave them unset and /sign-in offers the email link only.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=true
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
