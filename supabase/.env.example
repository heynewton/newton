# Copy to supabase/.env (git-ignored) to turn on Google (#131) and Apple (#27) sign-in on the
# local stack, then restart it (npm run db:stop && npm run db:start). The Supabase CLI reads this file and these
# override supabase/config.toml. The values are the dev OAuth client's, from Google Cloud, and the
# dev Services ID and client secret from Apple (docs/tokens.md). Leave a provider's lines out and
# /sign-in doesn't offer it. Apple only returns to https addresses on a real domain, so locally the
# Apple button gets as far as Apple; a full Apple sign-in needs the dev site.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=true
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_ENABLED=true
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
